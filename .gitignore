# Binaries
# Root-anchored so it only matches the built binary, not skills/canvas-cli/
bin/
dist/
/canvas-cli
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.txt
coverage.html

# Dependency directories
vendor/

# Go workspace file
go.work

# IDE
.idea/
.vscode/
.cursor/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Config and credentials (never commit these!)
.canvas-cli/
*.token
*.token.enc
config.yaml
config.yml

# Logs
*.log

# Temporary files
tmp/
temp/
.tmp/

# Build artifacts
*.deb
*.rpm
*.pkg
*.dmg

# Release archives
*.tar.gz
*.zip

# VCR cassettes (if used for testing)
test/fixtures/*.yaml
test/fixtures/*.json

.ai

# Canvas Swagger cache (populated by `make spec-sync`; re-fetch by deleting this dir)
.canvas-spec/

site/

# Claude session files
.claude/*.md
!.claude/agents/

# Generated by `canvas mcp tools`
mcp-tools.json
# Local deployment tool state
.netlify/
.cloudflare/
